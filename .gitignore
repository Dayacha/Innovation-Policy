# =============================================================================
# Innovation Policy Pipeline — .gitignore
# =============================================================================

# ── Temporary chat context dumps ─────────────────────────────────────────────
CONTEXT_FOR_CHAT.md
AUDIT_INSTRUCTIONS.md

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Config (contains API keys) ───────────────────────────────────────────────
config.yaml

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.vscode/
.idea/
.claude/

# ── Local recordings / archives ───────────────────────────────────────────────
create_llm_apikey.mov
Screen Recording *.zip
*.~lock.*

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# =============================================================================
# Data — what to track vs. ignore
# =============================================================================
#
# TRACK (commit to git):
#   Data/input/finance_bills/              source documents (DOCX)
#   Data/input/taxonomy/                   taxonomy reference files
#   Data/output/budget/rd_database.csv     combined app-ready database
#   Data/output/budget/*/                  per-country series, audit, gap reports
#   Data/output/budget/agency_registry.csv LLM-classified agency registry
#   Data/output/budget/discovered_agencies.json auto-discovered agencies
#   Data/output/reforms/output/            final reform panel & events
#
# IGNORE (large, sensitive, or regenerable):
#   *.pdf / *.docx in input                Finance Bills source files
#   Data/output/budget/raw_rows.csv        large intermediate (all parsed rows)
#   Data/output/budget/llm_cache/          LLM API response cache
#   Data/output/budget/llm_usage.json      operational cost log
#   Data/output/budget/run_log.jsonl       pipeline run log
#   Data/output/reforms/extracted_text/    raw PDF text (large, intermediate)
#   Data/output/reforms/reforms_json/      per-survey LLM output (intermediate)

# ── Source documents (too large for git) ──────────────────────────────────────
*.pdf
*.docx
*.doc
!Data/input/surveys/*.pdf

# ── Old output location ───────────────────────────────────────────────────────
Data/processed/

# ── Budget pipeline — intermediate / operational files ────────────────────────
Data/output/budget/raw_rows.csv
Data/output/budget/llm_cache/
Data/output/budget/llm_usage.json
Data/output/budget/run_log.jsonl
Data/output/budget/panel.csv
Data/output/budget/results.csv
Data/output/budget/results.xlsx
Data/output/budget/results.json
Data/output/budget/results_clean.csv
Data/output/budget/results_ai_verified.csv
Data/output/budget/results_review_status.csv
Data/output/budget/summary_by_series.csv
Data/output/budget/qa_report.csv
Data/output/budget/ai_validation/
Data/output/budget/audits/
Data/output/budget/full_text/
Data/output/budget/intermediate/
Data/output/budget/runs/

# ── Reform pipeline — intermediate files ──────────────────────────────────────
Data/output/reforms/extracted_text/
Data/output/reforms/reforms_json/
